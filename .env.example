# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
DEBUG=False
SECRET_KEY=genere-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (motor del proyecto). Si DB_ENGINE no se define se usa SQLite local.
DB_ENGINE=mysql
DB_NAME=sisertec
DB_USER=sisertec_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo: en desarrollo se imprime en consola. En producción usar SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.cl
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=notificaciones@ejemplo.cl

# Producción detrás de Nginx con HTTPS
# CSRF_TRUSTED_ORIGINS=https://sisertec.ejemplo.cl

# Clave para los usuarios de demostración (python manage.py cargar_demo)
DEMO_PASSWORD=
